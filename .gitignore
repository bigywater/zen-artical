venv/
__pycache__/
*.pyc
db.sqlite3
staticfiles/
.env

# tech 站的对外发布目录:纯构建产物,能从 backup/ (+ db.sqlite3) 用
# `manage.py build_static` 整体重新生成,不用进版本库。
public/
# backup/ 不要忽略:它是 db.sqlite3 之外唯一的灾难恢复手段(manifest.json +
# 每篇文章原文),按 tech/backup.py 的设计就是要跟着仓库走。

# 本地 Claude Code 配置
.claude/

# tools/articles 的临时目录、虚拟环境、下载缓存、输出(体积大,可重新生成)
tools/articles/*tmp/
tools/articles/*_venv/
tools/articles/out/
.DS_Store

# tools/articles/html 是生成过程的中间成品,文章已在 backup/ 里有存档
tools/articles/html/
